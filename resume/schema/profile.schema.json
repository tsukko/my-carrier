{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resume Profile",
  "type": "object",
  "required": ["meta", "profile", "skills", "experience", "contacts"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "generated_on_timezone": { "type": "string" }
      },
      "required": ["generated_on_timezone"],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "birthdate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "education": { "type": "string" },
        "location": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["name", "birthdate", "education", "title"],
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["languages", "tools"],
      "additionalProperties": false
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "title"],
        "properties": {
          "start": { "type": "string" },
          "end": { "type": "string" },
          "title": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "tech": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "link": { "type": "string" },
          "description": { "type": "string" },
          "tech": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "contacts": {
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "github": { "type": "string" },
        "website": { "type": "string" }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
